{
  "name": "ancilis-scan-action",
  "version": "0.1.0",
  "description": "AI agent security posture scanning for pull requests",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "package": "ncc build src/main.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "lint": "tsc --noEmit",
    "all": "npm run build && npm test && npm run package",
    "security:audit": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/github": "^8.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.39",
    "@vercel/ncc": "^0.38.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  },
  "license": "Apache-2.0",
  "overrides": {
    "js-yaml": "^4.2.0"
  }
}
