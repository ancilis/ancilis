          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "strict_capture": {
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "max_events",
        "max_bytes",
        "max_episodes",
        "max_attachments",
        "max_body_bytes",
        "max_diagnostic_keys",
        "strict_capture"
      ],
      "additionalProperties": false
    }
  }
