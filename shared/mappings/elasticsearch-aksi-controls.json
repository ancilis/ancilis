{
  "_version": "1.0.0",
  "_description": "Elasticsearch X-Pack Security audit log → AKSI control ID mapping. Elasticsearch is the dominant lexical+vector hybrid search engine; agents query it for retrieval (BM25 + dense vectors), log analysis, and security-data lookups. Each X-Pack security audit event captures one authentication, authorization, request-tampering, run-as, connection, or system-access decision against indices and cluster endpoints. event.action drives the primary signal; index name + privilege + url.path + tls.version drive additive flags. Synthetic findings (failed-auth burst, cross-index, sensitive-read burst) are emitted at the importer level by correlating events.",
  "_metadata": {
    "source_format": "elasticsearch",
    "schema": "elasticsearch-x-pack-security-audit-v1",
    "owner": "ancilis-importers",
    "cross_index_threshold": 10,
    "failed_auth_burst": 10,
    "sensitive_read_threshold": 50,
    "sensitive_indices": [
      ".security",
      ".kibana",
      "*-pii",
      "*-customers",
      "*-audit*",
      "*-credentials",
      "*-secrets"
    ],
    "privileged_url_patterns": [
      "/_cluster/settings",
      "/_security/*",
      "/_security/role*",
      "/_snapshot*",
      "/_reindex"
    ],
    "legacy_tls_versions": ["TLSv1.0", "TLSv1.1"],
    "signal_priority": [
      "tampered_request",
      "cluster_settings_modify",
      "security_config_change",
      "security_role_grant",
      "security_index_write",
      "security_index_read",
      "legacy_tls",
      "failed_auth_burst",
      "sensitive_read_burst",
      "authentication_failed",
      "anonymous_access_denied",
      "access_denied",
      "connection_denied",
      "run_as_granted",
      "system_access_granted",
      "manage_privilege_on_prod",
      "snapshot_operation",
      "reindex_sensitive",
      "wildcard_search_many",
      "msearch_many_indices",
      "sensitive_index_access",
      "long_lived_api_key",
      "non_rfc1918_client",
      "cross_index_pattern",
      "authentication_success",
      "access_granted_read"
    ],
    "result_levels": {
      "authentication_success": "PASS",
      "authentication_failed": "FLAG",
      "anonymous_access_denied": "PASS",
      "access_denied": "PASS",
      "access_granted_read": "PASS",
      "sensitive_index_access": "FLAG",
      "security_index_read": "FAIL",
      "security_index_write": "FAIL",
      "manage_privilege_on_prod": "FLAG",
      "tampered_request": "FAIL",
      "run_as_granted": "FLAG",
      "connection_denied": "FLAG",
      "system_access_granted": "FLAG",
      "long_lived_api_key": "FLAG",
      "wildcard_search_many": "FLAG",
      "msearch_many_indices": "FLAG",
      "reindex_sensitive": "FLAG",
      "snapshot_operation": "FLAG",
      "cluster_settings_modify": "FAIL",
      "security_config_change": "FAIL",
      "security_role_grant": "FAIL",
      "legacy_tls": "FAIL",
      "non_rfc1918_client": "FLAG",
      "failed_auth_burst": "FAIL",
      "cross_index_pattern": "FLAG",
      "sensitive_read_burst": "FAIL"
    }
  },
  "mappings": {
    "authentication_success": "PR-01",
    "authentication_failed": "PR-01",
    "anonymous_access_denied": "PR-02",
    "access_denied": "PR-02",
    "access_granted_read": "PR-04",
    "sensitive_index_access": "PR-04",
    "security_index_read": "PR-04",
    "security_index_write": "PR-02",
    "manage_privilege_on_prod": "PR-02",
    "tampered_request": "DE-01",
    "run_as_granted": "PR-01",
    "connection_denied": "PR-01",
    "system_access_granted": "PR-02",
    "long_lived_api_key": "PR-01",
    "wildcard_search_many": "PR-04",
    "msearch_many_indices": "PR-04",
    "reindex_sensitive": "PR-04",
    "snapshot_operation": "PR-02",
    "cluster_settings_modify": "PR-02",
    "security_config_change": "PR-02",
    "security_role_grant": "PR-02",
    "legacy_tls": "PR-04",
    "non_rfc1918_client": "PR-01",
    "failed_auth_burst": "PR-01",
    "cross_index_pattern": "PR-02",
    "sensitive_read_burst": "PR-04"
  }
}
