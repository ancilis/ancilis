{
  "_version": "1.0.0",
  "_description": "Slack audit-log → AKSI control ID mapping. Slack is the #1 destination for agent output in enterprise — agents post status updates, share files, summarize calls, mention users. Each agent message is a potential exfiltration surface (sensitive data leaves the controlled environment). The audit/v1/logs endpoint exports actions: message_posted, file_uploaded, file_shared_externally, channel_created, user_invited_to_channel, user_invited_to_workspace, external_user_added, dm_created, user_logout, files_acknowledged_dnsr, etc. The action drives the primary control; actor.type (app/bot vs user), entity.channel.is_external_shared, entity.file.is_external, and entity.message.has_links produce additive flags. file_shared_externally is treated as the top-priority exfiltration signal (DE-01 FAIL). A bot opening DMs is treated as a social-engineering surface (PR-04 FLAG). A cross-channel pattern (one bot actor posting to > N channels in the export) produces a synthetic PR-02 FLAG.",
  "_metadata": {
    "source_format": "slack_audit",
    "schema": "slack-audit-log-v1",
    "owner": "ancilis-importers",
    "cross_channel_threshold": 10,
    "sensitive_channel_patterns": ["*-private", "*-secure", "exec-*", "security-*", "incident-*"],
    "agent_actor_types": ["app", "bot"],
    "action_patterns": [
      {"action": "message_posted", "actor_type": "app", "signal": "agent_message_posted", "result": "PASS", "control": "PR-04"},
      {"action": "message_posted", "actor_type": "bot", "signal": "agent_message_posted", "result": "PASS", "control": "PR-04"},
      {"action": "file_uploaded", "actor_type": "app", "signal": "agent_file_uploaded", "result": "FLAG", "control": "PR-04"},
      {"action": "file_uploaded", "actor_type": "bot", "signal": "agent_file_uploaded", "result": "FLAG", "control": "PR-04"},
      {"action": "file_shared_externally", "actor_type": "*", "signal": "file_shared_externally", "result": "FAIL", "control": "DE-01"},
      {"action": "external_user_added", "actor_type": "*", "signal": "external_user_added", "result": "FLAG", "control": "PR-02"},
      {"action": "channel_created", "actor_type": "*", "signal": "channel_created", "result": "PASS", "control": "PR-05"},
      {"action": "user_invited_to_channel", "actor_type": "*", "signal": "user_invited_to_channel", "result": "PASS", "control": "PR-05"},
      {"action": "user_invited_to_workspace", "actor_type": "*", "signal": "user_invited_to_workspace", "result": "PASS", "control": "PR-05"},
      {"action": "dm_created", "actor_type": "app", "signal": "agent_dm_created", "result": "FLAG", "control": "PR-04"},
      {"action": "dm_created", "actor_type": "bot", "signal": "agent_dm_created", "result": "FLAG", "control": "PR-04"},
      {"action": "user_logout", "actor_type": "*", "signal": "user_logout", "result": "PASS", "control": "PR-05"},
      {"action": "files_acknowledged_dnsr", "actor_type": "*", "signal": "dnsr_acknowledged", "result": "PASS", "control": "PR-04"}
    ],
    "signal_priority": [
      "file_shared_externally",
      "agent_message_external_with_links",
      "agent_message_external",
      "agent_file_uploaded",
      "agent_dm_created",
      "external_channel_created",
      "external_user_added",
      "bot_targeting_user",
      "agent_message_posted",
      "channel_created",
      "user_invited_to_channel",
      "user_invited_to_workspace",
      "user_logout",
      "dnsr_acknowledged",
      "cross_channel_pattern",
      "cross_workspace_pattern"
    ],
    "result_levels": {
      "agent_message_posted": "PASS",
      "agent_message_external": "FLAG",
      "agent_message_external_with_links": "FAIL",
      "agent_file_uploaded": "FLAG",
      "file_shared_externally": "FAIL",
      "external_user_added": "FLAG",
      "external_channel_created": "FLAG",
      "channel_created": "PASS",
      "user_invited_to_channel": "PASS",
      "user_invited_to_workspace": "PASS",
      "agent_dm_created": "FLAG",
      "user_logout": "PASS",
      "dnsr_acknowledged": "PASS",
      "bot_targeting_user": "FLAG",
      "cross_channel_pattern": "FLAG",
      "cross_workspace_pattern": "FLAG"
    }
  },
  "mappings": {
    "agent_message_posted": "PR-04",
    "agent_message_external": "PR-04",
    "agent_message_external_with_links": "PR-04",
    "agent_file_uploaded": "PR-04",
    "file_shared_externally": "DE-01",
    "external_user_added": "PR-02",
    "external_channel_created": "PR-02",
    "channel_created": "PR-05",
    "user_invited_to_channel": "PR-05",
    "user_invited_to_workspace": "PR-05",
    "agent_dm_created": "PR-04",
    "user_logout": "PR-05",
    "dnsr_acknowledged": "PR-04",
    "bot_targeting_user": "PR-02",
    "cross_channel_pattern": "PR-02",
    "cross_workspace_pattern": "PR-02"
  }
}
