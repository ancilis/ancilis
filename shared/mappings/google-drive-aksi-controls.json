{
  "_version": "1.0.0",
  "_description": "Google Drive audit-event log → AKSI control ID mapping. Drive is the dominant cloud file-storage surface for businesses; agents read/write Drive files (RAG corpora, summaries, output reports) and Drive's Admin SDK Reports activity feed for applicationName=drive captures sharing, downloading, deletion, ACL changes and ownership transfers — the signals that gate data-loss-prevention. The Drive event-name drives the primary control. Agent activity (actor.callerType=APPLICATION_SERVICE_ACCOUNT) downloading documents is treated as a top-tier review signal. Public/external sharing transitions are the dominant exfiltration vector and resolve to DE-01 / PR-04 FAIL. Bulk-export and cross-domain-share patterns produce synthetic PR-04 FAILs.",
  "_metadata": {
    "source_format": "google_drive",
    "schema": "google-workspace-admin-reports-activities-drive-v1",
    "owner": "ancilis-importers",
    "large_file_threshold": 1000000000,
    "bulk_download_threshold": 50,
    "bulk_download_window_seconds": 3600,
    "cross_domain_share_threshold": 10,
    "cross_domain_share_window_seconds": 3600,
    "primary_workspace_domain": "",
    "restricted_mimes": [
      "text/csv",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-excel",
      "application/x-sqlite3",
      "application/json",
      "application/x-tar",
      "application/zip"
    ],
    "agent_download_doc_types": ["spreadsheet", "document", "pdf"],
    "signal_priority": [
      "share_outside_domain",
      "visibility_to_public_web",
      "visibility_to_link",
      "agent_document_download",
      "public_anonymous_access",
      "bulk_download_pattern",
      "cross_domain_share_pattern",
      "permanent_delete",
      "visibility_to_domain",
      "external_grant",
      "ownership_change",
      "acl_editors_change",
      "print_event",
      "large_download",
      "restricted_mime_download",
      "download_event",
      "trash_event",
      "view_event",
      "preview_event"
    ],
    "result_levels": {
      "view_event": "PASS",
      "preview_event": "PASS",
      "download_event": "FLAG",
      "agent_document_download": "FAIL",
      "print_event": "FLAG",
      "share_outside_domain": "FAIL",
      "visibility_to_public_web": "FAIL",
      "visibility_to_link": "FAIL",
      "visibility_to_domain": "FLAG",
      "acl_editors_change": "FLAG",
      "external_grant": "FLAG",
      "ownership_change": "FLAG",
      "trash_event": "PASS",
      "permanent_delete": "FLAG",
      "public_anonymous_access": "FAIL",
      "large_download": "FLAG",
      "restricted_mime_download": "FLAG",
      "bulk_download_pattern": "FAIL",
      "cross_domain_share_pattern": "FAIL"
    }
  },
  "mappings": {
    "view_event": "PR-04",
    "preview_event": "PR-04",
    "download_event": "PR-04",
    "agent_document_download": "PR-04",
    "print_event": "PR-04",
    "share_outside_domain": "DE-01",
    "visibility_to_public_web": "PR-04",
    "visibility_to_link": "PR-04",
    "visibility_to_domain": "PR-04",
    "acl_editors_change": "PR-02",
    "external_grant": "PR-04",
    "ownership_change": "PR-02",
    "trash_event": "PR-05",
    "permanent_delete": "PR-02",
    "public_anonymous_access": "PR-01",
    "large_download": "PR-04",
    "restricted_mime_download": "PR-04",
    "bulk_download_pattern": "PR-04",
    "cross_domain_share_pattern": "PR-04"
  }
}
