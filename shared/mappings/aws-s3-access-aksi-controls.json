{
  "_version": "1.0.0",
  "_description": "AWS S3 Server Access Log → AKSI control ID mapping. CloudTrail covers S3 IAM/control-plane operations (bucket creation, policy changes) but NOT data-plane object access by default — that goes to S3 Server Access Logs (or CloudTrail Data Events). Agents reading/writing S3 objects (RAG corpora, training data, intermediate artifacts) generate millions of events here. This mapping classifies object-level operations: GET/PUT/DELETE/COPY/HEAD/LIST and surfaces sensitive-prefix access, anonymous requests, legacy TLS, deprecated SigV2, large data egress, mass-read patterns, cross-bucket access surface, and failed-then-success privilege-escalation patterns. Sensitive-prefix matching uses fnmatch glob patterns evaluated against the S3 object key.",
  "_metadata": {
    "source_format": "aws_s3_access",
    "schema": "s3-server-access-log-v1",
    "owner": "ancilis-importers",
    "sensitive_prefix_patterns": [
      "customer-*",
      "customers/*",
      "payroll/*",
      "hr/*",
      "secrets/*",
      "keys/*",
      "credentials/*",
      "backup/*"
    ],
    "mass_read_threshold": 100,
    "cross_bucket_threshold": 5,
    "failed_then_success_window_seconds": 3600,
    "large_egress_threshold_bytes": 100000000,
    "operation_patterns": [
      {"operation": "REST.GET.OBJECT", "signal": "s3_object_read", "result": "PASS", "control": "PR-04"},
      {"operation": "WEBSITE.GET.OBJECT", "signal": "s3_object_read", "result": "PASS", "control": "PR-04"},
      {"operation": "REST.HEAD.OBJECT", "signal": "s3_object_head", "result": "PASS", "control": "PR-04"},
      {"operation": "REST.PUT.OBJECT", "signal": "s3_object_write", "result": "PASS", "control": "PR-04"},
      {"operation": "REST.POST.OBJECT", "signal": "s3_object_write", "result": "PASS", "control": "PR-04"},
      {"operation": "REST.DELETE.OBJECT", "signal": "s3_object_delete", "result": "PASS", "control": "PR-05"},
      {"operation": "BATCH.DELETE.OBJECT", "signal": "s3_batch_delete", "result": "FLAG", "control": "PR-02"},
      {"operation": "REST.LIST.BUCKETS", "signal": "s3_list_buckets", "result": "FLAG", "control": "PR-04"},
      {"operation": "REST.COPY.OBJECT", "signal": "s3_object_copy", "result": "PASS", "control": "PR-04"},
      {"operation": "REST.COPY.OBJECT_GET", "signal": "s3_object_copy", "result": "PASS", "control": "PR-04"},
      {"operation": "REST.PUT.ACL", "signal": "s3_acl_change", "result": "FLAG", "control": "PR-02"},
      {"operation": "REST.GET.ACL", "signal": "s3_acl_read", "result": "PASS", "control": "PR-05"},
      {"operation": "REST.PUT.ENCRYPTION", "signal": "s3_encryption_change", "result": "PASS", "control": "PR-04"},
      {"operation": "REST.PUT.BUCKETPOLICY", "signal": "s3_bucket_policy_change", "result": "FLAG", "control": "PR-02"},
      {"operation": "REST.DELETE.BUCKETPOLICY", "signal": "s3_bucket_policy_change", "result": "FLAG", "control": "PR-02"},
      {"operation": "S3.EXPIRE.OBJECT", "signal": "s3_lifecycle_expire", "result": "PASS", "control": "PR-05"}
    ],
    "error_code_signals": {
      "AccessDenied": {"signal": "s3_access_denied", "result": "PASS", "control": "PR-02"},
      "AllAccessDisabled": {"signal": "s3_access_denied", "result": "PASS", "control": "PR-02"},
      "InvalidAccessKeyId": {"signal": "s3_access_denied", "result": "FAIL", "control": "PR-01"},
      "SignatureDoesNotMatch": {"signal": "s3_signature_mismatch", "result": "FAIL", "control": "PR-01"},
      "RequestTimeout": {"signal": "s3_request_timeout", "result": "FLAG", "control": "DE-01"},
      "InternalError": {"signal": "s3_internal_error", "result": "FAIL", "control": "DE-01"},
      "ServiceUnavailable": {"signal": "s3_internal_error", "result": "FAIL", "control": "DE-01"}
    },
    "identity_signals": {
      "anonymous_request": {"result": "FAIL", "control": "PR-01"},
      "legacy_tls": {"result": "FAIL", "control": "PR-04"},
      "sigv2_deprecated": {"result": "FLAG", "control": "PR-04"},
      "sensitive_prefix_read": {"result": "FLAG", "control": "PR-04"},
      "sensitive_prefix_write": {"result": "FLAG", "control": "PR-04"},
      "cross_bucket_copy": {"result": "FLAG", "control": "PR-04"},
      "large_egress": {"result": "FLAG", "control": "PR-04"},
      "mass_data_read": {"result": "FAIL", "control": "PR-04"},
      "broad_bucket_access": {"result": "FLAG", "control": "PR-02"},
      "failed_then_success": {"result": "FLAG", "control": "PR-01"}
    },
    "result_levels": {
      "s3_object_read": "PASS",
      "s3_object_head": "PASS",
      "s3_object_write": "PASS",
      "s3_object_delete": "PASS",
      "s3_batch_delete": "FLAG",
      "s3_list_buckets": "FLAG",
      "s3_object_copy": "PASS",
      "s3_acl_change": "FLAG",
      "s3_acl_read": "PASS",
      "s3_encryption_change": "PASS",
      "s3_bucket_policy_change": "FLAG",
      "s3_lifecycle_expire": "PASS",
      "s3_access_denied": "PASS",
      "s3_signature_mismatch": "FAIL",
      "s3_request_timeout": "FLAG",
      "s3_internal_error": "FAIL",
      "anonymous_request": "FAIL",
      "legacy_tls": "FAIL",
      "sigv2_deprecated": "FLAG",
      "sensitive_prefix_read": "FLAG",
      "sensitive_prefix_write": "FLAG",
      "cross_bucket_copy": "FLAG",
      "large_egress": "FLAG",
      "mass_data_read": "FAIL",
      "broad_bucket_access": "FLAG",
      "failed_then_success": "FLAG",
      "unknown_operation": "FLAG"
    }
  },
  "mappings": {
    "s3_object_read": "PR-04",
    "s3_object_head": "PR-04",
    "s3_object_write": "PR-04",
    "s3_object_delete": "PR-05",
    "s3_batch_delete": "PR-02",
    "s3_list_buckets": "PR-04",
    "s3_object_copy": "PR-04",
    "s3_acl_change": "PR-02",
    "s3_acl_read": "PR-05",
    "s3_encryption_change": "PR-04",
    "s3_bucket_policy_change": "PR-02",
    "s3_lifecycle_expire": "PR-05",
    "s3_access_denied": "PR-02",
    "s3_signature_mismatch": "PR-01",
    "s3_request_timeout": "DE-01",
    "s3_internal_error": "DE-01",
    "anonymous_request": "PR-01",
    "legacy_tls": "PR-04",
    "sigv2_deprecated": "PR-04",
    "sensitive_prefix_read": "PR-04",
    "sensitive_prefix_write": "PR-04",
    "cross_bucket_copy": "PR-04",
    "large_egress": "PR-04",
    "mass_data_read": "PR-04",
    "broad_bucket_access": "PR-02",
    "failed_then_success": "PR-01",
    "unknown_operation": "PR-05"
  }
}
