{
  "_version": "1.0.0",
  "_description": "Zapier audit-log → AKSI control ID mapping. Zapier is the dominant low-code automation platform (7000+ app integrations) and is increasingly the agent-callable surface for AI workflows via Zapier AI Actions, Natural-Language Actions, and ChatGPT plugins. Audit log is exposed via the Team-plan audit log API and SCIM events. Distinct from n8n (self-hosted) — Zapier zaps execute in Zapier's SaaS, so the runtime evidence shape is different: actor identity, app-connection lifecycle, AI Action creation/invocation, and public share-link events are the load-bearing signals. Identity / share-link / public-export events drive privilege and exfiltration controls; Code-by-Zapier and Webhook steps drive code-surface and external-egress controls.",
  "_metadata": {
    "source_format": "zapier",
    "schema": "zapier-audit-log-v1",
    "owner": "ancilis-importers",
    "sensitive_apps": [
      "postgresql",
      "mongodb",
      "sftp",
      "dropbox",
      "google-drive",
      "salesforce",
      "hubspot",
      "stripe",
      "quickbooks",
      "xero",
      "zoho",
      "mailchimp"
    ],
    "large_data_threshold": 10000000,
    "high_volume_threshold": 1000,
    "cross_app_threshold": 5,
    "ai_action_burst": 5,
    "ai_action_burst_window_seconds": 3600,
    "high_volume_window_seconds": 3600,
    "webhook_allowlist": [],
    "critical_zap_indicators": {
      "min_runs_per_day": 100,
      "tags": ["production", "prod", "critical"]
    },
    "privileged_roles": ["Admin", "Owner"],
    "signal_priority": [
