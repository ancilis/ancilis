{
  "_version": "1.0.0",
  "_description": "Splunk notable event → AKSI control ID mapping. Each event's severity, status, disposition, category, and Splunk AI Assistant for SecOps autonomy fields select a control. Critical-severity open notables (status new/in_progress) become DE-01 FAIL (open critical incident); critical resolved+true_positive becomes PR-05 FAIL (confirmed real incident requiring audit-trail closure evidence); critical resolved+false_positive becomes PR-05 PASS. AI/ML category at high/critical severity becomes DE-01 FAIL with ai_agent_id captured. Splunk AI Assistant for SecOps fields (ai_runbook_executed, ai_action_taken, user_decision, ai_confidence_score) drive PR-02/PR-03 governance: autonomous high-impact actions without human review become PR-02 FAIL; rejected runbook actions become PR-02 FAIL; runbooks below the confidence threshold become PR-03 FLAG. Broad-impact alerts (_count_distinct_users) and high-volume AI synthetics layer PR-04 FLAG.",
  "_metadata": {
    "source_format": "splunk",
    "schema": "splunk-notable-events-v0",
    "owner": "ancilis-importers",
    "spec_url": "https://docs.splunk.com/Documentation/Splunk/latest/RESTREF/RESTsearch",
    "default_ai_confidence_threshold": 0.7,
    "default_broad_impact_user_count": 50,
    "default_ai_volume_per_day": 100,
    "default_false_positive_pattern_threshold": 20,
    "high_impact_actions": [
      "isolate_host",
      "block_user",
      "quarantine",
      "disable_account"
    ],
    "audit_relayed_sourcetypes": [
