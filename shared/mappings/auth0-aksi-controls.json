    "source_format": "auth0_tenant_logs",
    "schema": "auth0-tenant-logs-v1",
    "owner": "ancilis-importers",
    "cross_country_threshold": 3,
    "privileged_scope_patterns": ["admin", "read:users", "update:users", "delete:users", "create:users", "read:clients", "update:clients", "create:clients"],
    "type_to_human_name": {
