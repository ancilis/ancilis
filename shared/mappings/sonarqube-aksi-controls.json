{
  "_version": "1.0.0",
  "_description": "SonarQube `/api/issues/search` and `/api/qualitygates` results → AKSI control mapping. Combines issue type (BUG/VULNERABILITY/CODE_SMELL/SECURITY_HOTSPOT), severity (BLOCKER/CRITICAL/MAJOR/MINOR/INFO), status (OPEN/CONFIRMED/REOPENED/RESOLVED/CLOSED), resolution (FALSE-POSITIVE/WONTFIX/FIXED/REMOVED), CWE list, OWASP Top 10 tags, attribute (clean-code attribute), impacts (softwareQuality/severity pairs), is_ai_generated flag, confidence, new_code, and quality-gate conditions into one of {PASS, FLAG, FAIL} verdicts. Critical CWEs (CWE-78 Command Injection, CWE-89 SQL Injection, CWE-94 Code Injection, CWE-79 XSS, CWE-798 Hardcoded Credentials, CWE-327/CWE-330 Broken Crypto) escalate to FAIL regardless of base mapping. SonarQube AI CodeFix surfaces is_ai_generated=true on issues introduced by AI agents — these are tracked per-finding and aggregated for the AI-generated concentration synthetic.",
  "_metadata": {
    "source_format": "sonarqube",
    "schema": "sonarqube-issues-search-v1",
    "owner": "ancilis-importers",
    "spec_url": "https://next.sonarqube.com/sonarqube/web_api/api/issues",
    "high_density_blocker_per_project": 5,
    "ai_generated_concentration": 10,
    "cross_cwe_threshold": 5,
    "critical_cwes": [
      "CWE-78",
      "CWE-89",
      "CWE-94",
      "CWE-79",
      "CWE-798",
      "CWE-327",
      "CWE-330"
    ],
    "signal_priority": [
      "ai_generated_critical",
      "critical_cwe_command_injection",
      "critical_cwe_sql_injection",
      "critical_cwe_code_injection",
      "critical_cwe_xss",
      "hardcoded_credentials",
      "broken_crypto",
      "quality_gate_breached",
      "wontfix_blocker",
      "false_positive_resolution",
      "vulnerability_blocker_open",
      "vulnerability_critical_open",
      "vulnerability_major",
      "bug_blocker",
      "bug_critical",
      "security_impact_high",
      "new_code_critical",
      "low_confidence_critical",
      "code_smell_audit",
      "ai_hotspot_high",
      "hotspot_to_review_high",
      "hotspot_reviewed_safe",
      "qg_error_security_rating",
      "qg_error_coverage",
      "qg_error_multi_dim",
      "qg_warn"
    ]
  },
  "mappings": {
    "vulnerability_blocker_open":     {"control": "PR-03", "result": "FAIL"},
    "vulnerability_critical_open":    {"control": "PR-03", "result": "FAIL"},
    "vulnerability_major":            {"control": "PR-03", "result": "FLAG"},
    "bug_blocker":                    {"control": "PR-03", "result": "FAIL"},
    "bug_critical":                   {"control": "PR-03", "result": "FLAG"},
    "code_smell_audit":               {"control": "PR-05", "result": "PASS"},
    "critical_cwe_command_injection": {"control": "PR-03", "result": "FAIL"},
    "critical_cwe_sql_injection":     {"control": "PR-03", "result": "FAIL"},
    "critical_cwe_code_injection":    {"control": "PR-03", "result": "FAIL"},
    "critical_cwe_xss":               {"control": "PR-03", "result": "FAIL"},
    "hardcoded_credentials":          {"control": "DE-01", "result": "FAIL"},
    "broken_crypto":                  {"control": "PR-04", "result": "FAIL"},
    "false_positive_resolution":      {"control": "PR-05", "result": "PASS"},
    "wontfix_blocker":                {"control": "PR-02", "result": "FAIL"},
    "security_impact_high":           {"control": "PR-04", "result": "FAIL"},
    "ai_generated_critical":          {"control": "PR-03", "result": "FAIL"},
    "low_confidence_critical":        {"control": "PR-03", "result": "FLAG"},
    "new_code_critical":              {"control": "PR-03", "result": "FAIL"},
    "quality_gate_breached":          {"control": "PR-03", "result": "FAIL"},
    "hotspot_to_review_high":         {"control": "PR-04", "result": "FLAG"},
    "hotspot_reviewed_safe":          {"control": "PR-05", "result": "PASS"},
    "ai_hotspot_high":                {"control": "PR-04", "result": "FAIL"},
    "qg_error_security_rating":       {"control": "PR-04", "result": "FAIL"},
    "qg_error_coverage":              {"control": "PR-05", "result": "FLAG"},
    "qg_error_multi_dim":             {"control": "PR-03", "result": "FAIL"},
    "qg_warn":                        {"control": "PR-05", "result": "FLAG"}
  },
  "synthetics": {
    "high_density_blocker_per_project": {"control": "DE-01", "result": "FAIL", "description": "More than high_density_blocker_per_project OPEN BLOCKER vulnerabilities in the same project (broken-project signal)"},
    "ai_generated_concentration":       {"control": "PR-03", "result": "FLAG", "description": "More than ai_generated_concentration is_ai_generated=true issues in scan (agent quality drift)"},
    "cross_cwe_pattern":                {"control": "PR-03", "result": "FLAG", "description": "Same CWE with more than cross_cwe_threshold occurrences across distinct files (systemic issue)"}
  }
}
