{
  "_version": "1.0.0",
  "_description": "Semgrep `--json` finding → AKSI control mapping. Combines extra.severity, extra.metadata.category, metadata.cwe, metadata.confidence, metadata.likelihood/impact, validation_state, and is_ignored into one of {PASS, FLAG, FAIL} verdicts. Critical CWEs (CWE-78 Command Injection, CWE-89 SQL Injection, CWE-94 Code Injection, CWE-79 XSS, CWE-798 Hardcoded Credentials, CWE-327 Broken Crypto, CWE-330 Insufficient Random) escalate to FAIL regardless of base mapping. Confirmed-valid secrets (Semgrep Pro validators) → DE-01 FAIL. likelihood=HIGH + impact=HIGH escalates any base mapping to FAIL. metadata.ai-generated=true is captured per-finding and aggregated for the AI-assisted concentration synthetic.",
  "_metadata": {
    "source_format": "semgrep",
    "schema": "semgrep-cli-json-v1",
    "owner": "ancilis-importers",
    "spec_url": "https://semgrep.dev/docs/cli-reference/",
    "high_density_per_file": 5,
    "ai_assisted_concentration": 10,
    "cross_rule_threshold": 5,
    "critical_cwes": [
      "CWE-78",
      "CWE-89",
      "CWE-94",
      "CWE-79",
      "CWE-798",
      "CWE-327",
      "CWE-330"
    ],
    "signal_priority": [
      "validated_secret_confirmed",
      "critical_cwe_command_injection",
      "critical_cwe_sql_injection",
      "critical_cwe_code_injection",
      "critical_cwe_xss",
      "hardcoded_credentials",
      "broken_crypto",
      "likelihood_impact_high",
      "is_ignored",
      "validated_secret_invalid",
      "security_error_high_confidence",
      "security_error_medium_confidence",
      "security_error_low_confidence",
      "security_warning",
      "security_info",
      "correctness_error",
      "best_practice_error",
      "performance_any"
    ]
  },
  "mappings": {
    "security_error_high_confidence":   {"control": "PR-03", "result": "FAIL"},
    "security_error_medium_confidence": {"control": "PR-03", "result": "FAIL"},
    "security_error_low_confidence":    {"control": "PR-03", "result": "FLAG"},
    "security_warning":                 {"control": "PR-03", "result": "FLAG"},
    "security_info":                    {"control": "PR-03", "result": "PASS"},
    "best_practice_error":              {"control": "PR-05", "result": "FLAG"},
    "correctness_error":                {"control": "PR-03", "result": "FLAG"},
    "performance_any":                  {"control": "PR-05", "result": "PASS"},
    "critical_cwe_command_injection":   {"control": "PR-03", "result": "FAIL"},
    "critical_cwe_sql_injection":       {"control": "PR-03", "result": "FAIL"},
    "critical_cwe_code_injection":      {"control": "PR-03", "result": "FAIL"},
    "critical_cwe_xss":                 {"control": "PR-03", "result": "FAIL"},
    "hardcoded_credentials":            {"control": "DE-01", "result": "FAIL"},
    "broken_crypto":                    {"control": "PR-04", "result": "FAIL"},
    "validated_secret_confirmed":       {"control": "DE-01", "result": "FAIL"},
    "validated_secret_invalid":         {"control": "PR-05", "result": "PASS"},
    "is_ignored":                       {"control": "PR-02", "result": "FLAG"},
    "likelihood_impact_high":           {"control": "PR-03", "result": "FAIL"}
  },
  "synthetics": {
    "high_density_per_file":     {"control": "PR-03", "result": "FLAG", "description": "More than high_density_per_file ERROR-level findings in the same file (broken file signal)"},
    "ai_assisted_concentration": {"control": "PR-03", "result": "FLAG", "description": "More than ai_assisted_concentration ai-generated=true findings in scan (agent quality drift)"},
    "cross_rule_pattern":        {"control": "PR-03", "result": "FLAG", "description": "Same vulnerability_class with more than cross_rule_threshold occurrences across distinct files (systemic issue)"}
  }
}
