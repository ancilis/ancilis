    "js/xss": "PR-03",
    "py/reflected-xss": "PR-03",
    "js/xss-*": "PR-03",
    "py/xss-*": "PR-03",
    "js/hardcoded-credentials": "PR-05",
    "py/hardcoded-credentials": "PR-05",
    "cs/hardcoded-credentials": "PR-05",
    "java/hardcoded-credentials": "PR-05",
    "js/hardcoded-*": "PR-05",
    "py/hardcoded-*": "PR-05",
    "js/insecure-randomness": "PR-04",
    "py/insecure-randomness": "PR-04",
    "js/weak-cryptographic-algorithm": "PR-04",
    "py/weak-cryptographic-algorithm": "PR-04",
    "js/missing-rate-limiting": "PR-02",
    "py/missing-rate-limiting": "PR-02",
    "js/path-injection": "PR-03",
