      "bak"
    ],
    "privileged_role_set": ["co-owner", "editor", "owner"],
    "privileged_groups": ["admin", "administrators", "security-admin"],
    "shield_alert_priorities": {
      "high": "FAIL",
      "medium": "FLAG",
      "low": "FLAG"
    },
    "signal_priority": [
