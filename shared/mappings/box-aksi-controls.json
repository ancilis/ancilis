    "source_format": "box",
    "schema": "box-admin-events-v1",
    "owner": "ancilis-importers",
    "large_file_threshold": 1000000000,
    "bulk_download_threshold": 30,
    "bulk_download_window_seconds": 3600,
    "cross_folder_traversal_threshold": 100,
    "cross_folder_traversal_window_seconds": 3600,
    "primary_workspace_domain": "",
    "sensitive_extensions": [
      "csv",
