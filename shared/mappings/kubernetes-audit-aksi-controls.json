{
  "_version": "1.0.0",
  "_description": "Kubernetes apiserver audit-event → AKSI control ID mapping. The kube-apiserver is the single chokepoint for every cluster-mutating action: pod creation, secret access, RBAC modification, exec into pods, port-forward. For agents that operate K8s clusters (Devin's deploys, AIOps, custom DevOps agents), audit logs are THE canonical evidence source for who-did-what across cluster state. Mapping is verb + resource driven, with overlays for privileged-pod detection (hostNetwork/hostPID/privileged), un-pinned image tags (`:latest`), un-trusted registries, RBAC subject-group analysis (granting to system:authenticated == over-broad), impersonation, anonymous identities, exec/portforward (lateral-movement vectors), namespace deletions (bulk-impact), and synthetic cross-namespace / delete-burst patterns.",
  "_metadata": {
    "source_format": "kubernetes_audit",
    "schema": "audit.k8s.io/v1",
    "owner": "ancilis-importers",
    "cross_namespace_threshold": 5,
    "delete_burst_threshold": 10,
    "image_registry_allowlist": [
      "gcr.io",
      "docker.io",
      "quay.io",
      "public.ecr.aws",
      "ghcr.io",
      "registry.k8s.io",
      "k8s.gcr.io"
    ],
    "production_namespace_patterns": [
      "prod",
      "prod-*",
      "production",
      "production-*",
      "*-prod",
      "*-production"
    ],
    "verb_resource_patterns": [
      {"verb": "get", "resource": "pods", "signal": "pod_read", "result": "PASS", "control": "PR-04"},
      {"verb": "list", "resource": "pods", "signal": "pod_read", "result": "PASS", "control": "PR-04"},
      {"verb": "watch", "resource": "pods", "signal": "pod_read", "result": "PASS", "control": "PR-04"},
      {"verb": "get", "resource": "services", "signal": "service_read", "result": "PASS", "control": "PR-04"},
      {"verb": "list", "resource": "services", "signal": "service_read", "result": "PASS", "control": "PR-04"},
      {"verb": "watch", "resource": "services", "signal": "service_read", "result": "PASS", "control": "PR-04"},
      {"verb": "get", "resource": "configmaps", "signal": "configmap_read", "result": "PASS", "control": "PR-04"},
      {"verb": "list", "resource": "configmaps", "signal": "configmap_read", "result": "PASS", "control": "PR-04"},
      {"verb": "watch", "resource": "configmaps", "signal": "configmap_read", "result": "PASS", "control": "PR-04"},
      {"verb": "get", "resource": "secrets", "signal": "secret_read", "result": "FLAG", "control": "PR-04"},
      {"verb": "list", "resource": "secrets", "signal": "secret_mass_enumeration", "result": "FAIL", "control": "PR-04"},
      {"verb": "watch", "resource": "secrets", "signal": "secret_mass_enumeration", "result": "FAIL", "control": "PR-04"},
      {"verb": "create", "resource": "secrets", "signal": "secret_lifecycle_change", "result": "FLAG", "control": "PR-01"},
      {"verb": "update", "resource": "secrets", "signal": "secret_lifecycle_change", "result": "FLAG", "control": "PR-01"},
      {"verb": "patch", "resource": "secrets", "signal": "secret_lifecycle_change", "result": "FLAG", "control": "PR-01"},
      {"verb": "delete", "resource": "secrets", "signal": "secret_lifecycle_change", "result": "FLAG", "control": "PR-01"},
      {"verb": "delete", "resource": "namespaces", "signal": "namespace_delete", "result": "FAIL", "control": "PR-02"},
      {"verb": "create", "resource": "rolebindings", "signal": "rbac_grant", "result": "FAIL", "control": "PR-02"},
      {"verb": "create", "resource": "clusterrolebindings", "signal": "rbac_grant", "result": "FAIL", "control": "PR-02"},
      {"verb": "create", "resource": "tokenrequests", "signal": "service_account_token_create", "result": "FLAG", "control": "PR-01"}
    ],
    "subresource_signals": {
      "exec":        {"signal": "pod_exec",        "result": "FAIL", "control": "PR-02"},
      "attach":      {"signal": "pod_attach",      "result": "FAIL", "control": "PR-02"},
      "portforward": {"signal": "pod_portforward", "result": "FAIL", "control": "PR-02"}
    },
    "verb_signals": {
      "exec":        {"signal": "pod_exec",        "result": "FAIL", "control": "PR-02"},
      "attach":      {"signal": "pod_attach",      "result": "FAIL", "control": "PR-02"},
      "portforward": {"signal": "pod_portforward", "result": "FAIL", "control": "PR-02"}
    },
    "status_code_signals": {
      "403": {"signal": "rbac_denied",            "result": "PASS", "control": "PR-02"},
      "500": {"signal": "apiserver_internal_error", "result": "FAIL", "control": "DE-01"}
    },
    "identity_signals": {
      "anonymous_request":             {"result": "FAIL", "control": "PR-01"},
      "impersonation":                 {"result": "FLAG", "control": "PR-01"},
      "unrecognized_human_user":       {"result": "FLAG", "control": "PR-01"},
      "privileged_pod":                {"result": "FAIL", "control": "PR-02"},
      "unpinned_image_tag":            {"result": "FLAG", "control": "PR-05"},
      "untrusted_registry":            {"result": "FLAG", "control": "PR-04"},
      "production_workload_delete":    {"result": "FAIL", "control": "PR-02"},
      "rbac_grant_to_authenticated":   {"result": "FAIL", "control": "PR-02"},
      "cross_namespace_pattern":       {"result": "FLAG", "control": "PR-02"},
      "delete_burst_pattern":          {"result": "FLAG", "control": "PR-02"}
    },
    "result_levels": {
      "pod_read": "PASS",
      "service_read": "PASS",
      "configmap_read": "PASS",
      "secret_read": "FLAG",
      "secret_mass_enumeration": "FAIL",
      "secret_lifecycle_change": "FLAG",
      "privileged_pod": "FAIL",
      "unpinned_image_tag": "FLAG",
      "untrusted_registry": "FLAG",
      "namespace_delete": "FAIL",
      "production_workload_delete": "FAIL",
      "pod_exec": "FAIL",
      "pod_attach": "FAIL",
      "pod_portforward": "FAIL",
      "rbac_grant": "FAIL",
      "rbac_grant_to_authenticated": "FAIL",
      "service_account_token_create": "FLAG",
      "impersonation": "FLAG",
      "anonymous_request": "FAIL",
      "unrecognized_human_user": "FLAG",
      "rbac_denied": "PASS",
      "apiserver_internal_error": "FAIL",
      "cross_namespace_pattern": "FLAG",
      "delete_burst_pattern": "FLAG",
      "unknown_event": "FLAG"
    }
  },
  "mappings": {
    "pod_read": "PR-04",
    "service_read": "PR-04",
    "configmap_read": "PR-04",
    "secret_read": "PR-04",
    "secret_mass_enumeration": "PR-04",
    "secret_lifecycle_change": "PR-01",
    "privileged_pod": "PR-02",
    "unpinned_image_tag": "PR-05",
    "untrusted_registry": "PR-04",
    "namespace_delete": "PR-02",
    "production_workload_delete": "PR-02",
    "pod_exec": "PR-02",
    "pod_attach": "PR-02",
    "pod_portforward": "PR-02",
    "rbac_grant": "PR-02",
    "rbac_grant_to_authenticated": "PR-02",
    "service_account_token_create": "PR-01",
    "impersonation": "PR-01",
    "anonymous_request": "PR-01",
    "unrecognized_human_user": "PR-01",
    "rbac_denied": "PR-02",
    "apiserver_internal_error": "DE-01",
    "cross_namespace_pattern": "PR-02",
    "delete_burst_pattern": "PR-02",
    "unknown_event": "PR-05"
  }
}
