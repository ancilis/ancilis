{
  "_version": "1.0.0",
  "_description": "BigQuery Cloud Audit Log → AKSI control ID mapping. BigQuery is Google's cloud data warehouse and the GCP-native counterpart to Snowflake. Audit records are Cloud Audit AuditLog entries filtered to bigquery.googleapis.com, but BigQuery has its own granular event surface (jobChange, tableDataRead, datasetChange) that is materially richer than the generic GCP Cloud Audit importer can capture. Mapping is methodName + statementType + jobType driven, with overlays for sensitive-dataset patterns, sensitive field reads, large scans / cost anomalies, and IAM events. tableDataRead.fields raw VALUES are NEVER stored — only counts and a sensitive-pattern boolean — because column names themselves can leak schema and PII. Query text is reduced to a length integer. callerIp is /16 / /32 masked. principalEmail local part is redacted. Synthetic findings cover cross-dataset reach, sensitive-field-read bursts, and cumulative cost anomalies.",
  "_metadata": {
    "source_format": "bigquery_cloud_audit",
    "schema": "bigquery-cloud-audit-v1",
    "owner": "ancilis-importers",
    "large_scan_threshold_bytes": 100000000000,
    "large_billed_threshold_bytes": 1000000000000,
    "cost_anomaly_window_seconds": 3600,
    "cost_anomaly_billed_bytes_threshold": 10000000000000,
    "cross_dataset_threshold": 5,
    "high_volume_sensitive_field_threshold": 50,
    "high_volume_sensitive_field_window_seconds": 3600,
    "sensitive_dataset_patterns": [
      "*customer*",
      "*employee*",
      "*pii*",
      "*phi*",
      "*audit*",
      "*payments*",
      "*ssn*"
    ],
    "sensitive_field_patterns": [
      "ssn",
      "email",
      "phone",
      "credit_card",
      "pii_*"
    ],
    "external_principal_domain_patterns": [
      "gmail.com",
      "yahoo.com",
      "hotmail.com",
      "outlook.com",
      "protonmail.com",
      "icloud.com",
      "live.com",
      "aol.com"
    ],
    "method_name_patterns": {
      "JOB_INSERT": "*JobService.InsertJob*",
      "JOB_QUERY": "*JobService.Query*",
      "JOB_GET_QUERY_RESULTS": "*JobService.GetQueryResults*",
      "TABLE_GET": "*TableService.GetTable*",
      "TABLE_DELETE": "*TableService.DeleteTable*",
      "DATASET_GET": "*DatasetService.GetDataset*",
      "DATASET_PATCH": "*DatasetService.PatchDataset*",
      "DATASET_DELETE": "*DatasetService.DeleteDataset*"
    },
    "statement_type_patterns": {
      "SELECT":         {"signal": "bq_select",                  "result": "PASS", "control": "PR-04"},
      "INSERT":         {"signal": "bq_dml_write",               "result": "PASS", "control": "PR-04"},
      "UPDATE":         {"signal": "bq_dml_write",               "result": "PASS", "control": "PR-04"},
      "MERGE":          {"signal": "bq_dml_write",               "result": "PASS", "control": "PR-04"},
      "DELETE":         {"signal": "bq_dml_delete",              "result": "PASS", "control": "PR-05"},
      "TRUNCATE_TABLE": {"signal": "bq_dml_delete",              "result": "PASS", "control": "PR-05"},
      "CREATE_TABLE":   {"signal": "bq_schema_change",           "result": "FLAG", "control": "PR-02"},
      "ALTER_TABLE":    {"signal": "bq_schema_change",           "result": "FLAG", "control": "PR-02"},
      "DROP_TABLE":     {"signal": "bq_schema_destruction",      "result": "FAIL", "control": "PR-02"},
      "DROP_DATASET":   {"signal": "bq_dataset_destruction",     "result": "FAIL", "control": "PR-02"},
      "CREATE_VIEW":    {"signal": "bq_schema_change",           "result": "FLAG", "control": "PR-02"},
      "DROP_VIEW":      {"signal": "bq_schema_destruction",      "result": "FAIL", "control": "PR-02"},
      "GRANT":          {"signal": "bq_iam_grant",               "result": "FLAG", "control": "PR-02"},
      "REVOKE":         {"signal": "bq_iam_revoke",              "result": "PASS", "control": "PR-05"}
    },
    "job_type_patterns": {
      "QUERY":   {"signal": "bq_job_query",     "result": "PASS", "control": "PR-04"},
      "LOAD":    {"signal": "bq_job_load",      "result": "FLAG", "control": "PR-04"},
      "EXTRACT": {"signal": "bq_job_extract",   "result": "FAIL", "control": "PR-04"},
      "COPY":    {"signal": "bq_job_copy",      "result": "FLAG", "control": "PR-04"}
    },
    "error_code_patterns": {
      "7":  {"signal": "bq_permission_denied", "result": "PASS", "control": "PR-02"},
      "4":  {"signal": "bq_deadline_exceeded", "result": "FLAG", "control": "DE-01"}
    },
    "result_levels": {
      "bq_select": "PASS",
      "bq_select_sensitive_dataset": "FLAG",
      "bq_select_sensitive_field": "FAIL",
      "bq_dml_write": "PASS",
      "bq_dml_delete": "PASS",
      "bq_dml_delete_sensitive": "FAIL",
      "bq_schema_change": "FLAG",
      "bq_schema_destruction": "FAIL",
      "bq_dataset_destruction": "FAIL",
      "bq_iam_grant": "FLAG",
      "bq_iam_revoke": "PASS",
      "bq_iam_dataset_patch": "FLAG",
      "bq_table_delete_audit": "FLAG",
      "bq_dataset_delete_audit": "FLAG",
      "bq_job_query": "PASS",
      "bq_job_load": "FLAG",
      "bq_job_extract": "FAIL",
      "bq_job_copy": "FLAG",
      "bq_legacy_sql": "FLAG",
      "bq_large_scan": "FLAG",
      "bq_cost_anomaly": "FAIL",
      "bq_permission_denied": "PASS",
      "bq_deadline_exceeded": "FLAG",
      "bq_execution_error": "FAIL",
      "bq_authorization_denied": "PASS",
      "bq_service_account_principal": "PASS",
      "bq_external_principal": "FLAG",
      "bq_cross_dataset_pattern": "FLAG",
      "bq_high_volume_sensitive_field_read": "FAIL",
      "bq_cost_anomaly_synthetic": "FLAG",
      "bq_unknown_method": "FLAG"
    }
  },
  "mappings": {
    "bq_select": "PR-04",
    "bq_select_sensitive_dataset": "PR-04",
    "bq_select_sensitive_field": "PR-04",
    "bq_dml_write": "PR-04",
    "bq_dml_delete": "PR-05",
    "bq_dml_delete_sensitive": "PR-02",
    "bq_schema_change": "PR-02",
    "bq_schema_destruction": "PR-02",
    "bq_dataset_destruction": "PR-02",
    "bq_iam_grant": "PR-02",
    "bq_iam_revoke": "PR-05",
    "bq_iam_dataset_patch": "PR-02",
    "bq_table_delete_audit": "PR-02",
    "bq_dataset_delete_audit": "PR-02",
    "bq_job_query": "PR-04",
    "bq_job_load": "PR-04",
    "bq_job_extract": "PR-04",
    "bq_job_copy": "PR-04",
    "bq_legacy_sql": "PR-05",
    "bq_large_scan": "PR-04",
    "bq_cost_anomaly": "PR-04",
    "bq_permission_denied": "PR-02",
    "bq_deadline_exceeded": "DE-01",
    "bq_execution_error": "DE-01",
    "bq_authorization_denied": "PR-02",
    "bq_service_account_principal": "PR-05",
    "bq_external_principal": "PR-01",
    "bq_cross_dataset_pattern": "PR-02",
    "bq_high_volume_sensitive_field_read": "PR-04",
    "bq_cost_anomaly_synthetic": "PR-04",
    "bq_unknown_method": "PR-05"
  }
}
