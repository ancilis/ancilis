{
  "_version": "1.0.0",
  "_description": "PostgreSQL pgaudit → AKSI control ID mapping. PostgreSQL is the dominant open-source relational database; pgaudit (https://github.com/pgaudit/pgaudit) is the de-facto standard audit-logging extension and produces classified records (READ/WRITE/FUNCTION/ROLE/DDL/MISC) for every statement that touches tracked objects. Agents that query application data hit Postgres far more often than warehouses; this importer is the relational-database peer of the Snowflake (warehouse) importer. Mapping is command_tag + class + object_type-driven with sensitive-table overlays. The importer NEVER stores statement_text or error_message raw — only the lengths Postgres surfaces — and bare table names that match a sensitive pattern are reduced to match metadata. Cross-record patterns surface mass-sensitive-read, cross-database, and high-volume DDL signals as synthetic findings.",
  "_metadata": {
    "source_format": "postgres-pgaudit",
    "schema": "pgaudit-csvlog-v1",
    "owner": "ancilis-importers",
    "mass_delete_threshold": 1000,
    "cross_database_threshold": 3,
    "mass_sensitive_read_threshold": 100,
    "high_volume_ddl_threshold": 50,
    "pattern_window_seconds": 3600,
    "sensitive_table_patterns": [
      "*customers*",
      "*employees*",
      "*payroll*",
      "*pii*",
      "*phi*",
      "*ssn*",
      "*credit*",
      "*audit_log*",
      "pg_*shadow*",
      "pg_*authid*"
    ],
    "system_catalog_secret_tables": [
      "pg_authid",
      "pg_shadow",
      "pg_user_mapping"
    ],
    "legacy_tls_protocols": [
      "TLSv1.0",
      "TLSv1.1"
    ],
    "command_class_patterns": {
      "READ":      {"signal": "db_read",            "result": "PASS", "control": "PR-04"},
      "WRITE":     {"signal": "db_write",           "result": "PASS", "control": "PR-03"},
      "FUNCTION":  {"signal": "db_function_call",   "result": "PASS", "control": "PR-05"},
      "ROLE":      {"signal": "role_change",        "result": "FLAG", "control": "PR-02"},
      "DDL":       {"signal": "schema_change",      "result": "PASS", "control": "PR-05"},
      "MISC":      {"signal": "db_misc",            "result": "PASS", "control": "PR-05"},
      "MISC_SET":  {"signal": "session_set",        "result": "PASS", "control": "PR-05"}
    },
    "result_levels": {
      "db_read": "PASS",
      "db_read_sensitive": "FLAG",
      "db_read_credential_table": "FAIL",
      "db_write": "PASS",
      "db_write_mass_delete": "FLAG",
      "db_write_sensitive_delete": "FAIL",
      "db_function_call": "PASS",
      "schema_change": "PASS",
      "schema_destruction": "FAIL",
      "schema_change_sensitive": "FLAG",
      "role_change": "FLAG",
      "access_denied_role": "PASS",
      "access_denied_sensitive": "PASS",
      "fatal_error": "FAIL",
      "unencrypted_connection": "FAIL",
      "legacy_tls": "FAIL",
      "copy_to_program": "FAIL",
      "copy_sensitive": "FLAG",
      "external_client_on_prod": "FLAG",
      "over_privileged_routine": "FLAG",
      "superuser_drop_role": "FAIL",
      "set_role_chain": "FLAG",
      "cross_database_pattern": "FLAG",
      "mass_sensitive_read": "FAIL",
      "high_volume_ddl": "FLAG",
      "db_misc": "PASS",
      "session_set": "PASS",
      "unknown_class": "FLAG"
    }
  },
  "mappings": {
    "db_read": "PR-04",
    "db_read_sensitive": "PR-04",
    "db_read_credential_table": "PR-04",
    "db_write": "PR-03",
    "db_write_mass_delete": "PR-02",
    "db_write_sensitive_delete": "PR-02",
    "db_function_call": "PR-05",
    "schema_change": "PR-05",
    "schema_destruction": "PR-02",
    "schema_change_sensitive": "PR-02",
    "role_change": "PR-02",
    "access_denied_role": "PR-02",
    "access_denied_sensitive": "PR-02",
    "fatal_error": "DE-01",
    "unencrypted_connection": "PR-04",
    "legacy_tls": "PR-04",
    "copy_to_program": "PR-04",
    "copy_sensitive": "PR-04",
    "external_client_on_prod": "PR-01",
    "over_privileged_routine": "PR-02",
    "superuser_drop_role": "PR-02",
    "set_role_chain": "PR-02",
    "cross_database_pattern": "PR-02",
    "mass_sensitive_read": "PR-04",
    "high_volume_ddl": "PR-02",
    "db_misc": "PR-05",
    "session_set": "PR-05",
    "unknown_class": "PR-05"
  }
}
