{
  "_version": "1.0.0",
  "_description": "Qdrant vector store audit event → AKSI control ID mapping. Qdrant is the dominant Rust-based vector database in self-hosted RAG stacks. Each event in a Qdrant audit export (REST/gRPC operation) becomes one EvaluationResult. Operation type and error status drive the primary control mapping; additional FLAG signals are added for raw-vector exposure (with_vectors=true), un-scoped searches (no filter_keys), over-fetch (limit > threshold), and exact full-scans (exact=true). Synthetic findings (cross-collection actor pattern) are emitted at the importer level by correlating events within a single export. Filter values, vector data, and payload contents are NEVER stored — only structural keys + counts.",
  "_metadata": {
    "source_format": "qdrant",
    "schema": "qdrant-audit-log-v1",
    "owner": "ancilis-importers",
    "default_limit_threshold": 500,
    "default_cross_collection_detection": true,
    "signal_priority": [
      "error_status_internal",
      "error_status_forbidden",
      "error_status_bad_request",
      "error_status_not_found",
      "operation_create_collection",
      "operation_delete_collection",
      "operation_snapshot_create",
      "operation_snapshot_recover",
      "search_with_vectors",
      "search_no_filter",
      "search_limit_exceeded",
      "search_exact_scan",
      "cross_collection_pattern",
      "operation_search_success",
      "operation_scroll_success",
      "operation_upsert_success",
      "operation_delete_success"
    ],
    "result_levels": {
      "operation_search_success": "PASS",
      "operation_scroll_success": "PASS",
      "operation_upsert_success": "PASS",
      "operation_delete_success": "PASS",
      "operation_create_collection": "FLAG",
      "operation_delete_collection": "FLAG",
      "operation_snapshot_create": "FLAG",
      "operation_snapshot_recover": "FLAG",
      "search_with_vectors": "FLAG",
      "search_no_filter": "FLAG",
      "search_limit_exceeded": "FLAG",
      "search_exact_scan": "FLAG",
      "cross_collection_pattern": "FLAG",
      "error_status_forbidden": "FAIL",
      "error_status_bad_request": "FLAG",
      "error_status_internal": "FAIL",
      "error_status_not_found": "FLAG"
    }
  },
  "mappings": {
    "operation_search_success": "PR-04",
    "operation_scroll_success": "PR-04",
    "operation_upsert_success": "PR-03",
    "operation_delete_success": "PR-05",
    "operation_create_collection": "PR-05",
    "operation_delete_collection": "PR-05",
    "operation_snapshot_create": "PR-05",
    "operation_snapshot_recover": "PR-05",
    "search_with_vectors": "PR-04",
    "search_no_filter": "PR-04",
    "search_limit_exceeded": "PR-04",
    "search_exact_scan": "PR-04",
    "cross_collection_pattern": "PR-02",
    "error_status_forbidden": "PR-02",
    "error_status_bad_request": "PR-03",
    "error_status_internal": "DE-01",
    "error_status_not_found": "PR-02"
  }
}
