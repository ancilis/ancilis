{
  "_version": "1.0.0",
  "_description": "Salesforce Event Monitoring (EventLogFile + RealTimeEventMonitoring) → AKSI control ID mapping. Salesforce is the dominant enterprise CRM and Agentforce/Einstein agents read and mutate customer records (Contact, Account, Lead, Opportunity, Case). Each event type carries a different risk profile: Login/LoginAs is identity (PR-01), bulk DML is scope (PR-02), data/report/file/wave exports are exfiltration surface (PR-04), Apex exceptions are baseline detection (DE-01), and low-confidence Einstein predictions are provenance (PR-03). Cross-object access by a single Agentforce user and high-volume agents produce synthetic PR-04 FLAGs. All identifiers are pseudonymous Salesforce IDs and are stored verbatim; usernames are reduced to domain-only, IPs masked to /16, URIs path-normalized with query strings stripped, and SOQL row-ID suffixes truncated to last-8.",
  "_metadata": {
    "source_format": "salesforce_event_monitoring",
    "schema": "salesforce-event-log-file-v60",
    "owner": "ancilis-importers",
    "sensitive_object_types": [
      "Contact",
      "Account",
      "Lead",
      "Opportunity",
      "Case"
    ],
    "threshold_metadata": {
      "rows_returned_threshold": 1000,
      "rows_processed_threshold": 10000,
      "file_size_bytes_threshold": 104857600,
      "apex_run_time_threshold_ms": 30000,
      "api_response_time_threshold_ms": 60000,
      "cross_object_threshold": 8,
      "high_volume_agent_threshold": 5000
    },
    "einstein_confidence_threshold": 0.5,
    "legacy_tls_versions": ["TLSv1.0", "TLSv1.1"],
    "signal_priority": [
