{
  "_version": "1.0.0",
  "_description": "Mixpanel product-analytics export → AKSI control ID mapping. Mixpanel exposes user behavior via `/2.0/export` (events) and an Engage profile API plus an audit log of admin actions. Agents that emit events to Mixpanel can leak PII through event properties: emails, SSNs, credit-card-shaped strings, $user_id linking. The importer maps sensitive-pattern matches in event properties (computed by Mixpanel client-side scanners or by an Ancilis-side preprocessor) to PR-04 with severity escalating from FLAG (email) to FAIL→BLOCK (SSN, credit-card). It also handles GDPR-relevant signals: tracking_consent_recorded=false in EU-resident user is FAIL, data_residency_changed audit action is FAIL, gdpr_deletion_request audit action is PASS evidence. Synthetic findings cover high-volume sensitive-pattern bursts and PII concentration per agent.",
  "_metadata": {
    "source_format": "mixpanel",
    "schema": "mixpanel-export-v1",
    "owner": "ancilis-importers",
    "high_volume_threshold": 100,
    "high_volume_window_seconds": 3600,
    "pii_concentration_threshold": 0.05,
    "over_tracking_threshold": 30,
    "sensitive_event_property_keys": [
      "ssn",
      "credit_card",
      "phone",
      "passport",
      "full_address",
      "tax_id",
      "bank_account",
      "date_of_birth",
      "drivers_license"
    ],
    "block_sensitive_pattern_kinds": [
      "ssn_like_pattern",
      "credit_card_like_pattern"
    ],
    "flag_sensitive_pattern_kinds": [
      "email"
    ],
    "identity_linking_events": ["$identify", "$alias", "$create_alias"],
    "people_set_events": ["$people_set", "$people_set_once", "$people_union", "$people_append"],
    "eu_data_residency_regions": ["EU", "DE", "FR", "IE", "NL", "ES", "IT"],
    "webhook_allowlist": [],
    "signal_priority": [
      "sensitive_pattern_ssn",
      "sensitive_pattern_credit_card",
      "people_set_sensitive_property",
      "eu_no_consent",
      "audit_data_residency_changed",
      "high_volume_sensitive",
      "pii_concentration",
      "sensitive_pattern_email",
      "sensitive_pattern_generic",
      "identity_linking",
      "over_tracking",
      "cross_region_tracking",
      "non_eu_no_consent",
      "audit_data_export",
      "audit_retention_policy_changed",
      "audit_webhook_url_added",
      "audit_project_member_added",
      "audit_api_key_created_human",
      "audit_gdpr_deletion_request",
      "is_imported"
    ],
    "result_levels": {
      "sensitive_pattern_ssn": "FAIL",
      "sensitive_pattern_credit_card": "FAIL",
      "sensitive_pattern_email": "FLAG",
      "sensitive_pattern_generic": "FLAG",
      "people_set_sensitive_property": "FAIL",
      "identity_linking": "FLAG",
      "over_tracking": "FLAG",
      "cross_region_tracking": "FLAG",
      "eu_no_consent": "FAIL",
      "non_eu_no_consent": "FLAG",
      "is_imported": "PASS",
      "audit_data_export": "FLAG",
      "audit_data_residency_changed": "FAIL",
      "audit_retention_policy_changed": "FLAG",
      "audit_gdpr_deletion_request": "PASS",
      "audit_api_key_created_human": "FLAG",
      "audit_webhook_url_added": "FLAG",
      "audit_project_member_added": "FLAG",
      "high_volume_sensitive": "FAIL",
      "pii_concentration": "FAIL"
    }
  },
  "mappings": {
    "sensitive_pattern_ssn": "PR-04",
    "sensitive_pattern_credit_card": "PR-04",
    "sensitive_pattern_email": "PR-04",
    "sensitive_pattern_generic": "PR-04",
    "people_set_sensitive_property": "PR-04",
    "identity_linking": "PR-04",
    "over_tracking": "PR-04",
    "cross_region_tracking": "PR-04",
    "eu_no_consent": "PR-04",
    "non_eu_no_consent": "PR-05",
    "is_imported": "PR-05",
    "audit_data_export": "PR-04",
    "audit_data_residency_changed": "PR-04",
    "audit_retention_policy_changed": "PR-04",
    "audit_gdpr_deletion_request": "PR-05",
    "audit_api_key_created_human": "PR-01",
    "audit_webhook_url_added": "PR-04",
    "audit_project_member_added": "PR-02",
    "high_volume_sensitive": "PR-04",
    "pii_concentration": "PR-04"
  }
}
