{
  "_version": "1.0.0",
  "_description": "Snowflake QUERY_HISTORY / LOGIN_HISTORY / ACCESS_HISTORY → AKSI control ID mapping. Snowflake is the dominant cloud data warehouse; agents that query customer data, generate insights, or train on warehouse-stored corpora hit Snowflake. The audit-log surface is much richer than a generic SQL warehouse: BASE_OBJECTS_ACCESSED tells us which physical tables a query hit even when the query targets a view, POLICIES_REFERENCED tells us whether masking / row-access policies fired, BYTES_SCANNED tells us blast radius, and ACCOUNTADMIN-role-on-routine-SELECT calls out over-privileged service accounts. Mapping is QUERY_TYPE-driven with EXECUTION_STATUS / ERROR_CODE / ROLE_NAME overlays. Sensitive-table classification is fnmatch-based on BASE/DIRECT_OBJECTS_ACCESSED. Login-history events are mapped to PR-01 (identity); failed-login bursts and cross-database query patterns produce synthetic findings. The importer NEVER stores QUERY_TEXT, the full BASE/DIRECT_OBJECTS_ACCESSED list, or QUERY_TAG values — those carry SQL / table-name leakage / PII risk.",
  "_metadata": {
    "source_format": "snowflake",
    "schema": "snowflake-account-usage-v1",
    "owner": "ancilis-importers",
    "large_scan_threshold_bytes": 1000000000,
    "cross_database_threshold": 3,
    "high_volume_sensitive_read_threshold": 50,
    "brute_force_threshold": 5,
    "brute_force_window_seconds": 3600,
    "sensitive_table_patterns": [
      "CUSTOMER*",
      "EMPLOYEE*",
      "FINANCIAL*",
      "PII*",
      "PHI*",
      "SSN*",
      "CREDIT*",
      "SALARY*"
    ],
    "privilege_admin_roles": [
      "ACCOUNTADMIN",
      "SECURITYADMIN",
      "SYSADMIN"
    ],
    "agent_user_patterns": [
      "*_SVC",
      "*_AGENT",
      "AGENT_*",
      "SVC_*",
      "BOT_*",
      "*_BOT"
    ],
    "login_failure_error_codes": [
      390100,
      390101,
      390102,
      390103,
      390104,
      390105,
      390106,
      390108,
      390109
    ],
    "privilege_denied_error_codes": [
      3001,
      3003,
      90030
    ],
    "query_type_patterns": {
      "SELECT": {"signal": "warehouse_read", "result": "PASS", "control": "PR-04"},
      "INSERT": {"signal": "warehouse_write", "result": "PASS", "control": "PR-04"},
      "UPDATE": {"signal": "warehouse_write", "result": "PASS", "control": "PR-04"},
      "MERGE":  {"signal": "warehouse_write", "result": "PASS", "control": "PR-04"},
      "DELETE": {"signal": "warehouse_delete", "result": "PASS", "control": "PR-05"},
      "TRUNCATE": {"signal": "warehouse_delete", "result": "PASS", "control": "PR-05"},
      "DROP":   {"signal": "schema_destruction", "result": "FAIL", "control": "PR-02"},
      "ALTER":  {"signal": "schema_change", "result": "FLAG", "control": "PR-02"},
      "CREATE": {"signal": "schema_change", "result": "FLAG", "control": "PR-02"},
      "GRANT":  {"signal": "privilege_grant", "result": "FLAG", "control": "PR-02"},
      "REVOKE": {"signal": "privilege_revoke", "result": "PASS", "control": "PR-05"},
      "USE":    {"signal": "session_context", "result": "PASS", "control": "PR-05"},
      "SHOW":   {"signal": "metadata_read", "result": "PASS", "control": "PR-05"},
      "COPY":   {"signal": "data_ingress", "result": "FLAG", "control": "PR-04"},
      "PUT":    {"signal": "stage_upload", "result": "PASS", "control": "PR-04"},
      "GET":    {"signal": "stage_download", "result": "FLAG", "control": "PR-04"},
      "UNLOAD": {"signal": "data_exfiltration", "result": "FAIL", "control": "PR-04"},
      "CALL":   {"signal": "procedure_call", "result": "PASS", "control": "PR-05"}
    },
    "login_event_patterns": {
      "LOGIN_MFA": {"signal": "login_mfa", "result": "PASS", "control": "PR-01"},
      "LOGIN_SERVICE": {"signal": "login_service_account", "result": "PASS", "control": "PR-01"},
      "LOGIN_NO_MFA": {"signal": "login_no_mfa", "result": "FAIL", "control": "PR-01"},
      "LOGIN_FAILED": {"signal": "login_failed", "result": "FLAG", "control": "PR-01"},
      "BRUTE_FORCE": {"signal": "brute_force_pattern", "result": "FAIL", "control": "PR-01"},
      "MFA_ENROLLED": {"signal": "mfa_enrolled", "result": "PASS", "control": "PR-01"}
    },
    "result_levels": {
      "warehouse_read": "PASS",
