{
  "_version": "1.0.0",
  "_description": "Milvus vector database audit-event → AKSI control ID mapping. Milvus (https://milvus.io) is the largest open-source distributed vector database used at billion-vector scale. Each event in a Milvus access log (proxy.accesslog) becomes one EvaluationResult. Operation type, RBAC change, status code, is_root, and is_admin drive the primary control mapping; additional FLAG signals are added for over-fetch (limit > threshold), un-scoped vector search (expr_present=false), payload retrieval on Search (with_payload=true), and write-with-eventual-consistency. Synthetic findings (cross-collection actor pattern, privilege-grant burst) are emitted at the importer level by correlating events within a single export. Filter expressions, output field names, partition names raw, search_params.params details, and full client_ip/user_agent are NEVER stored — only structural shape + counts + masked /16 IP + first-80-chars-plus-sha256 user_agent.",
  "_metadata": {
    "source_format": "milvus",
    "schema": "milvus-accesslog-v2.5",
    "owner": "ancilis-importers",
    "over_fetch_threshold": 1000,
    "cross_collection_threshold": 5,
    "privilege_grant_burst_threshold": 10,
    "privilege_grant_burst_window_seconds": 3600,
    "signal_priority": [
      "root_user_routine_op",
      "permission_denied",
      "unauthenticated",
      "admin_grant",
      "admin_drop",
      "status_error_other",
      "rbac_change",
      "privilege_grant_burst",
      "operation_backup",
      "operation_restore",
      "operation_create_collection",
      "operation_drop_collection",
      "operation_alter_collection",
      "operation_create_index",
      "operation_drop_index",
      "admin_on_read_op",
      "search_overfetch",
      "search_unscoped",
      "search_with_payload",
      "insert_eventual_consistency",
      "cross_collection_pattern",
      "operation_search_success",
      "operation_query_success",
      "operation_insert_success",
      "operation_upsert_success",
      "operation_delete_success"
    ],
    "result_levels": {
