{
  "_version": "1.0.0",
  "_description": "AWS ECR (Elastic Container Registry) → AKSI control ID mapping. ECR is the canonical container registry on AWS — AI agents that ship code (Devin, Claude Code in CI, Cursor agents) push container images here, and supply-chain attacks (typosquatting, vulnerable base images, malicious packages, unsigned tags, mutable production tags) flow through it. CloudTrail-derived ECR events (PutImage, BatchGetImage, PutLifecyclePolicy, PutImageScanningConfiguration, PutImageTagMutability, DeleteRepository, DeleteImages, BatchDeleteImage, PutRegistryPolicy, DeleteRegistryPolicy, InitiateLayerUpload, CompleteLayerUpload, DescribeImageScanFindings) plus native scan_findings (vulnerability counts, signature status, SBOM presence, image age) drive the mapping. Critical-vulnerability pushes, unsigned production images, signature verification failures, scan-on-push disablement, and root usage are FAILs. Mutable tags in production, deletion of registry governance, lifecycle-policy retention reductions, and cross-account pulls are FLAGs. Synthetic findings cover repo-vulnerability concentration, cross-account-pull burst, and high-velocity bot pushes.",
  "_metadata": {
    "source_format": "aws_ecr",
    "schema": "ecr-cloudtrail-event-record-v1.0",
    "owner": "ancilis-importers",
    "production_repo_patterns": ["prod*", "release*", "main*"],
    "critical_packages": [
      "openssl",
      "libcrypto",
      "log4j",
      "glibc",
      "kernel*",
      "openssh",
      "sudo",
      "systemd"
    ],
    "high_severity_threshold": 5,
    "image_age_days_threshold": 365,
    "cross_account_pull_threshold": 50,
    "vulnerability_concentration_threshold": 3,
    "high_velocity_push_threshold": 30,
    "high_velocity_window_seconds": 3600,
    "cross_account_pull_window_seconds": 3600,
    "event_signals": {
      "PutImage":                            {"signal": "ecr_put_image",                       "result": "PASS", "control": "PR-05"},
      "BatchGetImage":                       {"signal": "ecr_batch_get_image",                 "result": "PASS", "control": "PR-04"},
