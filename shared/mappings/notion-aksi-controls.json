{
  "_version": "1.0.0",
  "_description": "Notion audit-event log → AKSI control ID mapping. Notion is the dominant knowledge-management platform: agents create/modify pages, databases, and comments — and agent-edited Notion pages have become a primary 'AI memory' surface. Each event carries an actor (person or bot), a type (page.* / database.* / comment.* / user.* / integration.* / workspace.*) and structured details. The type drives the primary control. Actor.type=bot is the central provenance signal: bot-authored knowledge, bot deletions, bot bulk-sweeps, and bot comments on high-priority pages all fire. Public-share posture (password protection, expiry), external sharing, schema removals, write-scope grants, bulk workspace exports, and external user adds produce additive signals. Bot-velocity (one bot doing > N edits in a 1h window) and cross-page (one bot touching > N distinct pages) yield synthetic PR-02 FLAGs.",
  "_metadata": {
    "source_format": "notion",
    "schema": "notion-audit-event-export-v1",
    "owner": "ancilis-importers",
    "bot_velocity_threshold": 50,
    "bot_velocity_window_seconds": 3600,
    "cross_page_threshold": 100,
    "export_size_threshold_bytes": 100000000,
    "high_priority_page_tags": ["confidential", "restricted", "secret", "pii", "legal"],
    "agent_marker_patterns": ["[ai]", "[agent]", "(generated)", "(ai)"],
    "write_scope_names": ["update_content", "insert_content", "read_content"],
    "primary_workspace_domain": "",
    "signal_priority": [
      "page_deleted_by_bot",
      "public_unprotected_share",
      "public_no_expiry",
      "workspace_export_html_large",
      "page_created_by_bot",
      "public_protected_share",
      "external_share",
      "schema_column_removal",
      "row_deleted_by_bot",
      "integration_added",
      "write_scope_grant",
      "workspace_export_small",
      "external_user_added",
      "bot_comment_high_priority",
      "page_updated_by_bot",
      "page_created_by_user",
      "page_deleted_by_user",
      "user_removed",
      "bot_velocity_pattern",
      "cross_page_pattern"
    ],
    "result_levels": {
      "page_created_by_bot": "FLAG",
      "page_created_by_user": "PASS",
      "page_updated_by_bot": "PASS",
      "page_deleted_by_bot": "FAIL",
      "page_deleted_by_user": "PASS",
      "public_unprotected_share": "FAIL",
      "public_protected_share": "FLAG",
      "public_no_expiry": "FAIL",
      "external_share": "FLAG",
      "schema_column_removal": "FLAG",
      "row_deleted_by_bot": "FLAG",
      "integration_added": "FLAG",
      "write_scope_grant": "FLAG",
      "workspace_export_html_large": "FAIL",
      "workspace_export_small": "FLAG",
      "external_user_added": "FLAG",
      "user_removed": "PASS",
      "bot_comment_high_priority": "FLAG",
      "bot_velocity_pattern": "FLAG",
      "cross_page_pattern": "FLAG"
    }
  },
  "mappings": {
    "page_created_by_bot": "PR-01",
    "page_created_by_user": "PR-05",
    "page_updated_by_bot": "PR-05",
    "page_deleted_by_bot": "PR-02",
    "page_deleted_by_user": "PR-05",
    "public_unprotected_share": "DE-01",
    "public_protected_share": "PR-04",
    "public_no_expiry": "PR-04",
    "external_share": "PR-04",
    "schema_column_removal": "PR-05",
    "row_deleted_by_bot": "PR-02",
    "integration_added": "PR-01",
    "write_scope_grant": "PR-02",
    "workspace_export_html_large": "PR-04",
    "workspace_export_small": "PR-04",
    "external_user_added": "PR-02",
    "user_removed": "PR-05",
    "bot_comment_high_priority": "PR-01",
    "bot_velocity_pattern": "PR-02",
    "cross_page_pattern": "PR-02"
  }
}
