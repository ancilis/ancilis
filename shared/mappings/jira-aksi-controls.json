{
  "_version": "1.0.0",
  "_description": "Atlassian Jira audit-record log (/rest/api/3/auditing/record) → AKSI control ID mapping. Jira is the dominant project-management tool in enterprise; agents file tickets, transition statuses, change permissions, and run automations. Each record carries a category (user management / permissions / workflows / configuration / issue / auto-configuration / ...), a summary, an authorAccountId, an eventSource (AUDIT/AUTOMATION/API), an isAutomatedAction flag, an objectItem, and a changedValues array. The category+summary combination drives the primary control. Bot-authored issue creation, automated workflow changes, global permission grants, post-creation Reporter changes, security-level escalation to Public, in-active-sprint issue deletion, and permission scheme changes produce additive flags or fails. Bot-velocity (one bot creating > N issues in a 1h window) and cross-project (one bot touching > N projects) yield synthetic PR-02 FLAGs.",
  "_metadata": {
    "source_format": "jira_audit_record",
    "schema": "jira-audit-record-export-v1",
    "owner": "ancilis-importers",
    "bot_account_patterns": [
      "*[bot]*",
      "*-bot",
      "bot-*",
      "automation*",
      "agent-*",
      "*-agent",
      "557058:agent-*",
      "557058:bot-*"
    ],
    "bot_velocity_threshold": 20,
    "bot_velocity_window_seconds": 3600,
    "cross_project_threshold": 10,
    "summary_truncate_chars": 200,
    "signal_priority": [
      "global_permission_grant",
      "workflow_scheme_deleted",
      "security_level_to_public",
      "active_sprint_issue_deleted",
      "user_permission_change",
      "project_permission_scheme_change",
      "permission_scheme_change",
      "server_configuration_updated",
      "workflow_scheme_automated_update",
      "reporter_post_creation_change",
      "agent_authored_issue",
      "bot_issue_clone",
      "user_created",
      "user_deleted",
      "auto_configuration",
      "automation_event",
      "api_event",
      "automated_action",
      "bot_velocity_pattern",
      "cross_project_pattern"
    ],
    "result_levels": {
      "user_created": "FLAG",
      "user_deleted": "PASS",
      "user_permission_change": "FLAG",
      "global_permission_grant": "FAIL",
      "project_permission_scheme_change": "FLAG",
      "permission_scheme_change": "FLAG",
      "workflow_scheme_automated_update": "FLAG",
      "workflow_scheme_deleted": "FAIL",
      "server_configuration_updated": "FLAG",
      "auto_configuration": "PASS",
      "agent_authored_issue": "FLAG",
      "active_sprint_issue_deleted": "FAIL",
      "bot_issue_clone": "FLAG",
      "automation_event": "PASS",
      "api_event": "PASS",
      "automated_action": "PASS",
      "security_level_to_public": "FAIL",
      "reporter_post_creation_change": "FLAG",
      "bot_velocity_pattern": "FLAG",
      "cross_project_pattern": "FLAG"
    }
  },
  "mappings": {
    "user_created": "PR-01",
    "user_deleted": "PR-05",
    "user_permission_change": "PR-02",
    "global_permission_grant": "PR-02",
    "project_permission_scheme_change": "PR-02",
    "permission_scheme_change": "PR-02",
    "workflow_scheme_automated_update": "PR-05",
    "workflow_scheme_deleted": "PR-02",
    "server_configuration_updated": "PR-02",
    "auto_configuration": "PR-05",
    "agent_authored_issue": "PR-01",
    "active_sprint_issue_deleted": "PR-02",
    "bot_issue_clone": "PR-05",
    "automation_event": "PR-05",
    "api_event": "PR-05",
    "automated_action": "PR-05",
    "security_level_to_public": "PR-04",
    "reporter_post_creation_change": "PR-05",
    "bot_velocity_pattern": "PR-02",
    "cross_project_pattern": "PR-02"
  }
}
