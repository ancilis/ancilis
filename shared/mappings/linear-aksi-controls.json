{
  "_version": "1.0.0",
  "_description": "Linear audit-event log → AKSI control ID mapping. Linear is the dominant project-management tool for engineering teams; agents file issues, comment, link PRs, and change priorities. Each event carries an actor (user or bot), an action (create/update/remove/archive/unarchive) on a Linear entity (Issue/Comment/Project/Cycle/Reaction/User/Team/Document/Attachment), and structured data fields. The type+action combination drives the primary control. Bot/agent provenance, priority escalation, state regression, in-progress deletion, comment removal, team permission change, external attachments, and webhook triggers produce additive flags. Bot-velocity (one bot creating > N issues in a 1h window) and cross-team (one bot touching > N teams) yield synthetic PR-02 FLAGs.",
  "_metadata": {
    "source_format": "linear",
    "schema": "linear-audit-event-export-v1",
    "owner": "ancilis-importers",
    "bot_velocity_threshold": 20,
    "bot_velocity_window_seconds": 3600,
    "cross_team_threshold": 5,
    "large_title_chars": 200,
    "large_description_chars": 10000,
    "allowlist_attachment_hosts": [],
    "high_priority_levels": [1, 2],
    "in_progress_state_types": ["started", "completed"],
    "regression_from_state_types": ["started", "completed"],
    "regression_to_state_types": ["backlog"],
    "signal_priority": [
      "issue_remove_in_progress",
      "issue_state_regression",
      "team_permission_change",
      "priority_escalation_by_bot",
      "agent_authored_issue",
      "bot_comment_high_priority",
      "comment_remove",
      "external_attachment",
      "long_description",
      "long_title_by_bot",
      "project_update_by_bot",
      "trigger_webhook",
      "trigger_automation",
      "issue_create_user",
      "issue_archive",
      "project_archive",
      "document_event",
      "bot_velocity_pattern",
      "cross_team_pattern"
    ],
    "result_levels": {
      "issue_create_user": "PASS",
      "agent_authored_issue": "FLAG",
      "priority_escalation_by_bot": "FLAG",
      "issue_state_regression": "FLAG",
      "issue_remove_in_progress": "FAIL",
      "issue_archive": "PASS",
      "bot_comment_high_priority": "FLAG",
      "comment_remove": "FLAG",
      "project_update_by_bot": "FLAG",
      "project_archive": "PASS",
      "team_permission_change": "FLAG",
      "document_event": "PASS",
      "external_attachment": "FLAG",
      "trigger_automation": "PASS",
      "trigger_webhook": "FLAG",
      "long_title_by_bot": "FLAG",
      "long_description": "FLAG",
      "bot_velocity_pattern": "FLAG",
      "cross_team_pattern": "FLAG"
    }
  },
  "mappings": {
    "issue_create_user": "PR-05",
    "agent_authored_issue": "PR-01",
    "priority_escalation_by_bot": "PR-02",
    "issue_state_regression": "PR-05",
    "issue_remove_in_progress": "PR-02",
    "issue_archive": "PR-05",
    "bot_comment_high_priority": "PR-01",
    "comment_remove": "PR-05",
    "project_update_by_bot": "PR-05",
    "project_archive": "PR-05",
    "team_permission_change": "PR-02",
    "document_event": "PR-04",
    "external_attachment": "PR-04",
    "trigger_automation": "PR-05",
    "trigger_webhook": "PR-01",
    "long_title_by_bot": "PR-05",
    "long_description": "PR-04",
    "bot_velocity_pattern": "PR-02",
    "cross_team_pattern": "PR-02"
  }
}
