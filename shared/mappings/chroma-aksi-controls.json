{
  "_version": "1.0.0",
  "_description": "Chroma vector store operation log → AKSI control ID mapping. Chroma is the most-used open-source vector store in indie/small-team RAG stacks (chosen by ~50% of solo devs for its simplicity). Each operation in a Chroma audit/operation export becomes one EvaluationResult. Operation type drives the primary control mapping; additional FLAG signals are added for raw-vector exposure (include contains 'embeddings'), un-scoped document fetches (include contains 'documents' with no where filter), over-fetch (n_results > threshold), single-tenant deployments using both default tenant AND default database with explicit user_id (a common dev-mode misconfig in production), and unspecified embedding functions on production-looking collections (which lead to inconsistent vectors). Synthetic findings (cross-collection actor pattern, ≥3 collections per user_id) are emitted at the importer level. Filter values, document content, embedding vectors, and query text are NEVER stored — only structural keys + counts.",
  "_metadata": {
    "source_format": "chroma",
    "schema": "chroma-operation-log-v1",
    "owner": "ancilis-importers",
    "default_n_results_threshold": 1000,
    "default_cross_collection_detection": true,
    "cross_collection_threshold": 3,
    "signal_priority": [
      "error_status_internal",
      "error_status_authorization",
      "error_status_dimension_mismatch",
      "error_status_other",
      "operation_create_collection",
      "operation_delete_collection",
      "operation_modify",
      "include_embeddings",
      "include_documents_unscoped",
      "n_results_exceeded",
      "default_tenant_database",
      "default_embedding_function",
      "cross_collection_pattern",
      "operation_query_success",
      "operation_get_success",
      "operation_add_success",
      "operation_upsert_success",
      "operation_update_success",
      "operation_delete_success"
    ],
    "result_levels": {
      "operation_query_success": "PASS",
      "operation_get_success": "PASS",
      "operation_add_success": "PASS",
      "operation_upsert_success": "PASS",
      "operation_update_success": "PASS",
      "operation_delete_success": "PASS",
      "operation_create_collection": "FLAG",
      "operation_delete_collection": "FLAG",
      "operation_modify": "FLAG",
      "include_embeddings": "FLAG",
      "include_documents_unscoped": "FLAG",
      "n_results_exceeded": "FLAG",
      "default_tenant_database": "FLAG",
      "default_embedding_function": "FLAG",
      "cross_collection_pattern": "FLAG",
      "error_status_authorization": "FAIL",
      "error_status_dimension_mismatch": "FLAG",
      "error_status_internal": "FAIL",
      "error_status_other": "FAIL"
    }
  },
  "mappings": {
    "operation_query_success": "PR-04",
    "operation_get_success": "PR-04",
    "operation_add_success": "PR-03",
    "operation_upsert_success": "PR-03",
    "operation_update_success": "PR-03",
    "operation_delete_success": "PR-05",
    "operation_create_collection": "PR-05",
    "operation_delete_collection": "PR-05",
    "operation_modify": "PR-05",
    "include_embeddings": "PR-04",
    "include_documents_unscoped": "PR-04",
