{
  "id": "gdpr",
  "name": "GDPR",
  "version": "0.1",
  "description": "EU General Data Protection Regulation overlay. Activated by personal data, health data, children's data, or biometric data declarations.",
  "triggered_by_classifications": ["DC-PII", "DC-PHI", "DC-MINOR", "DC-BIO"],
  "applicable_data_types": ["personal_info", "health_records", "patient_data", "childrens_data", "biometric_data"],
  "control_adjustments": {
    "PR-02": {
      "threshold_adjustment": "strict",
      "additional_evidence_fields": ["lawful_basis", "purpose_limitation"],
      "regulatory_citation": "GDPR Art. 6 - Lawfulness of processing"
    },
    "PR-04": {
      "threshold_adjustment": "strict",
      "additional_evidence_fields": ["data_categories", "cross_border_transfer", "encryption_status"],
      "regulatory_citation": "GDPR Art. 32 - Security of processing"
    },
    "PR-05": {
      "threshold_adjustment": "strict",
      "additional_evidence_fields": ["processing_purpose", "data_subject_category", "lawful_basis"],
      "regulatory_citation": "GDPR Art. 30 - Records of processing activities"
    },
    "DE-01": {
      "threshold_adjustment": "standard",
      "additional_evidence_fields": ["data_breach_indicators"],
      "regulatory_citation": "GDPR Art. 33 - Notification of personal data breach"
    }
  },
  "evidence_requirements": {
    "PR-02": ["lawful_basis", "purpose_limitation"],
    "PR-04": ["data_categories", "cross_border_transfer", "encryption_status"],
    "PR-05": ["processing_purpose", "data_subject_category"]
  },
  "framework_mapping": {
    "PR-01": ["Art. 5(1)(f)"],
    "PR-02": ["Art. 6", "Art. 5(1)(b)"],
    "PR-03": ["Art. 25"],
    "PR-04": ["Art. 25", "Art. 32"],
    "PR-05": ["Art. 30"],
    "DE-01": ["Art. 33", "Art. 34"]
  },
  "evidence_retention_minimum_days": 365,
  "human_oversight_required": false,
  "notes": "GDPR requires data protection by design and by default (Art. 25), security of processing (Art. 32), and records of processing activities (Art. 30). This overlay adds data protection evidence fields and tightens controls handling personal data."
}
