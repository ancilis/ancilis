{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ancilis Configuration",
  "description": "Schema for ancilis.yaml configuration files",
  "type": "object",
  "required": [
    "agent"
  ],
  "additionalProperties": true,
  "properties": {
    "config_version": {
      "type": "integer",
      "minimum": 1,
      "default": 2,
      "description": "Ancilis configuration schema version. Unversioned files are treated as v1 and can be migrated with `ancilis config migrate`."
    },
    "agent": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Agent identifier"
        },
        "description": {
          "type": "string",
          "default": "",
          "description": "Human-readable description"
        },
        "owner": {
          "type": "string",
          "default": "",
          "description": "Human owner for accountability"
        },
        "llm_provider": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "LLM provider identifier (e.g. openai, anthropic, aws-bedrock). Stored in evidence classification_context for platform discovery."
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "audit",
            "enforce"
          ],
          "default": "audit",
          "description": "audit: evaluate all, log results, allow all actions. enforce: evaluate all, block policy violations."
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(GOV-0[1-7]|ID-0[1-5]|PR-(0[1-9]|1[0-2])|DE-0[1-6]|RS-0[1-6]|RC-0[1-3]|PAY-0[1-2])$": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Allowlist. Empty = discover at runtime, all allowed."
            },
            "blocked": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Blocklist. Takes precedence over allowed."
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_actions_per_minute": {
              "type": [
                "integer",
                "null"
              ],
              "default": null,
              "description": "Rate limiting. null = no limit."
            },
            "allowed_destinations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Where the agent can send data. Empty = unrestricted."
            },
            "blocked_destinations": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "Where the agent cannot send data."
            }
          }
        }
      }
    },
    "my_agent_handles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "agent_payments",
          "ai_training_data",
          "biometric_data",
          "card_security_codes",
          "childrens_data",
          "cji",
          "controlled_unclassified",
          "credit_cards",
          "criminal_justice_information",
          "critical_infrastructure",
          "dual_use_technology",
          "ear_controlled",
          "education_records",
          "export_controlled",
          "federal_cloud",
          "federal_contract",
          "federal_contract_info",
          "fedramp_system",
          "financial_data",
          "financial_records",
          "general",
          "government_cui",
          "government_documents",
          "government_system",
          "health_records",
          "legal_data",
          "legal_privileged",
          "material_nonpublic",
          "medical_device",
          "medical_device_data",
          "mnpi",
          "nonpublic_personal_info",
          "npi",
          "patient_data",
          "payment_cards",
          "payment_data",
          "personal_info",
          "public_data",
          "sensitive_authentication_data",
          "student_data",
          "trade_secrets"
        ]
      },
      "description": "Declaring data types activates compliance overlays."
    },
    "certification_targets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Certification standards or extension targets to activate. Examples: ['aiuc-1'], ['AGENT_PAYMENTS'], ['X402']."
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlays": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Which overlays to activate. Auto-detected from my_agent_handles if omitted."
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storage": {
              "type": "string",
              "enum": [
                "local"
              ],
              "default": "local",
              "description": "Evidence storage backend."
            },
            "retention_days": {
              "type": "integer",
              "default": 365,
              "minimum": 1,
              "description": "How long to keep evidence records."
            }
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Enable dependency/SBOM vulnerability scanning."
            },
            "severity_threshold": {
              "type": "string",
              "enum": ["critical", "high", "medium", "low"],
              "default": "high",
              "description": "Minimum vulnerability severity that should fail CI checks."
            },
            "ignore": {
              "type": "array",
              "items": { "type": "string" },
              "default": [],
              "description": "Vulnerability IDs to ignore."
            }
          }
        }
      }
    }
  },
  "$defs": {
    "aksi_control_id": {
      "type": "string",
      "enum": [
        "GOV-01",
        "GOV-02",
        "GOV-03",
        "GOV-04",
        "GOV-05",
        "GOV-06",
        "GOV-07",
        "ID-01",
        "ID-02",
        "ID-03",
        "ID-04",
        "ID-05",
        "PR-01",
        "PR-02",
        "PR-03",
        "PR-04",
        "PR-05",
        "PR-06",
        "PR-07",
        "PR-08",
        "PR-09",
        "PR-10",
        "PR-11",
        "PR-12",
        "DE-01",
        "DE-02",
        "DE-03",
        "DE-04",
        "DE-05",
        "DE-06",
        "RS-01",
        "RS-02",
        "RS-03",
        "RS-04",
        "RS-05",
        "RS-06",
        "RC-01",
        "RC-02",
        "RC-03",
        "PAY-01",
        "PAY-02"
      ]
    }
  }
}
