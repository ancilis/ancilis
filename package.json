{
  "name": "ancilis",
  "version": "0.2.0",
  "description": "TypeScript SDK for Ancilis runtime evaluation and policy enforcement",
  "type": "module",
  "main": "./dist/ancilis/index.js",
  "types": "./dist/ancilis/index.d.ts",
  "bin": {
    "ancilis": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/ancilis/index.js",
      "types": "./dist/ancilis/index.d.ts"
    },
    "./testing": {
      "import": "./dist/ancilis/testing/index.js",
      "types": "./dist/ancilis/testing/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "dist/**/*.d.ts.map",
    "shared/**/*.json",
    "shared/**/*.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint typescript/src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist ancilis-*.tgz",
    "pack:smoke": "npm run build && node scripts/ts_package_smoke.mjs",
    "security:audit:npm": "npm audit --audit-level=high",
    "security:audit:scan-action": "npm --prefix scan-action run security:audit",
    "security:audit:python-lock": "pip-audit --desc --requirement requirements-lock.txt --ignore-vuln CVE-2026-4539 --ignore-vuln PYSEC-2025-183",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test && node scripts/ts_package_smoke.mjs"
  },
  "keywords": [
    "ai",
    "agents",
    "ai-agents",
    "agent-security",
    "agent-compliance",
    "ai-security",
    "ai-compliance",
    "runtime-security",
    "compliance-automation",
    "audit-evidence",
    "soc2",
    "hipaa",
    "pci-dss",
    "gdpr",
    "mcp",
    "model-context-protocol",
    "llmops",
    "ai-governance",
    "data-classification",
    "risk-management"
  ],
  "author": "Kevin Bauer <kevin@ancilis.ai>",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ancilis/ancilis.git"
  },
  "homepage": "https://ancilis.ai",
  "bugs": {
    "url": "https://github.com/ancilis/ancilis/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.2-r.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.0.0",
    "js-yaml": "^4.1.1",
    "typescript": "^5.5.0",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "express-rate-limit": "8.5.1",
    "fast-uri": "3.1.2",
    "hono": "4.12.18",
    "ip-address": "10.2.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples"
  }
}
