{
  "name": "ancilis",
  "version": "0.1.0",
  "description": "Preview TypeScript SDK for Ancilis runtime evaluation and policy enforcement",
  "type": "module",
  "main": "./dist/ancilis/index.js",
  "types": "./dist/ancilis/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ancilis/index.js",
      "types": "./dist/ancilis/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "shared",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint typescript/src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist ancilis-*.tgz",
    "pack:smoke": "npm run build && node scripts/ts_package_smoke.mjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "agent",
    "preview",
    "mcp",
    "middleware",
    "policy",
    "evaluation",
    "compliance",
    "runtime"
  ],
  "author": {
    "name": "Kevin Bauer",
    "email": "kevin@ancilis.ai"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/ancilis/ancilis.git"
  },
  "homepage": "https://ancilis.ai",
  "bugs": {
    "url": "https://github.com/ancilis/ancilis/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "duckdb": "^1.0.0",
    "yaml": "^2.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.2"
  }
}
